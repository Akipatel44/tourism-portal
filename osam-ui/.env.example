# Example env (safe to commit) - replace values as needed for your environment
# Client-side variables must start with NEXT_PUBLIC_ to be exposed to browser code.
NEXT_PUBLIC_API_BASE=https://api.example.com/api
NEXT_PUBLIC_IMAGE_BASE=https://cdn.example.com/images
NEXT_PUBLIC_FEATURE_BETA=false
NEXT_PUBLIC_FEATURE_GALLERY_UPLOAD=true

# For secrets (API keys, DB credentials), use platform secret management or
# `.env.local` which should NOT be committed.
# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Auth Configuration
NEXT_PUBLIC_TOKEN_KEY=osam_access_token

# Environment
NODE_ENV=development
